{
  "name": "esports-ceo-desktop",
  "productName": "eSports CEO",
  "version": "1.0.0",
  "description": "eSports CEO para PC",
  "author": "Palica-127",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "copiar": "node copiar.cjs",
    "start": "npm run copiar && electron .",
    "exe": "npm run copiar && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.palica127.esportsceo",
    "productName": "eSports CEO",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "icon.png",
      "app/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "eSportsCEO-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Palica-127/E-sportsCEO.git"
  }
}